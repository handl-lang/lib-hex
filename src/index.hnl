--- hex.encode -- encode a string to hexadecimal.
--- hex.decode -- decode a hexadecimal string.
cap "hex.encode"
cap "hex.decode"
op "hex.encode" : String -> String
  guarantee: IsHex(output)
op "hex.decode" : String -> String
  guarantee: True

--- pure-handl impls (the module arrows):
from "./encode.hnl" export encode
from "./decode.hnl" export decode

cap "hex.codec"
op "hex.codec" : () -> Value
export codec := () ~> ({ "type": "codec", "name": "hex", "encode": encode, "decode": decode })
